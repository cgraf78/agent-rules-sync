#!/usr/bin/env bash
# Installer symlink safety and idempotence.

set -o pipefail

repo_root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P) || exit 1
# shellcheck source=lib/test.sh
. "$repo_root/test/lib/test.sh"

installer_wrapper="$repo_root/install.sh"
installer_delegate="$repo_root/support/install-checkout.sh"

_assert_file_exists "installer: generated checkout wrapper is present" \
  "$installer_wrapper"
_assert_file_exists "installer: checkout-owned delegate is present" \
  "$installer_delegate"
_assert_contains "installer: wrapper identifies the shared generator" \
  "Generated by cgraf78/actions checkout-installer" \
  "$(sed -n '2p' "$installer_wrapper")"

work=$(_tmpdir)
prefix="$work/prefix"

PREFIX="$prefix" "$installer_wrapper" >"$work/install.out"
status=$?
_assert_exit "installer: direct checkout succeeds" 0 "$status"
target="$prefix/bin/agent-rules-sync"
if [[ -L "$target" ]]; then
  _pass "installer: creates a command symlink"
else
  _fail "installer: creates a command symlink"
fi
_assert_eq "installer: points at this checkout" \
  "$repo_root/bin/agent-rules-sync" "$(readlink "$target")"
"$target" --help >/dev/null 2>&1
status=$?
_assert_exit "installer: direct-checkout command executes" 0 "$status"

PREFIX="$prefix" "$installer_wrapper" >"$work/reinstall.out"
status=$?
_assert_exit "installer: reinstall is idempotent" 0 "$status"

managed_source="$work/managed-source"
managed_remote="$work/agent-rules-sync.git"
work_physical=$(cd -P -- "$work" && pwd -P)
managed_checkout="$work_physical/managed/agent-rules-sync"
managed_prefix="$work/managed-prefix"
mkdir -p "$managed_source"
cp "$installer_wrapper" "$managed_source/install.sh"
cp -R "$repo_root/bin" "$repo_root/lib" "$repo_root/support" \
  "$managed_source/"
git -C "$managed_source" init --quiet --initial-branch=main --template=''
git -C "$managed_source" config core.hooksPath /dev/null
git -C "$managed_source" config commit.gpgsign false
git -C "$managed_source" config user.name 'Agent Rules Installer Test'
git -C "$managed_source" config user.email \
  agent-rules-installer@example.invalid
git -C "$managed_source" add .
git -C "$managed_source" commit --quiet -m 'managed installer fixture'
git init --quiet --bare --initial-branch=main "$managed_remote"
git -C "$managed_source" remote add origin "$managed_remote"
git -C "$managed_source" push --quiet --set-upstream origin main
curl --fail --silent --show-error "file://$managed_source/install.sh" |
  PREFIX="$managed_prefix" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$managed_checkout" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$managed_remote" \
    bash -s >"$work/managed.out"
pipeline_status=("${PIPESTATUS[@]}")
_assert_exit "installer: curl bootstrap source succeeds" 0 \
  "${pipeline_status[0]}"
_assert_exit "installer: piped bootstrap succeeds" 0 \
  "${pipeline_status[1]}"
_assert_file_exists "installer: piped bootstrap keeps a managed checkout" \
  "$managed_checkout/.git/HEAD"
managed_target="$managed_prefix/bin/agent-rules-sync"
_assert_eq "installer: piped command points at managed checkout" \
  "$managed_checkout/bin/agent-rules-sync" "$(readlink "$managed_target")"
"$managed_target" --help >/dev/null 2>&1
status=$?
_assert_exit "installer: piped managed-checkout command executes" 0 "$status"

custom_bin="$work/custom-bin"
BIN_DIR="$custom_bin" "$installer_delegate" >"$work/custom.out"
status=$?
_assert_exit "installer: custom BIN_DIR succeeds" 0 "$status"
if [[ -L "$custom_bin/agent-rules-sync" ]]; then
  _pass "installer: honors BIN_DIR"
else
  _fail "installer: honors BIN_DIR"
fi

blocked="$work/blocked"
mkdir -p "$blocked"
printf 'owned elsewhere\n' >"$blocked/agent-rules-sync"
set +e
BIN_DIR="$blocked" "$installer_delegate" \
  >"$work/blocked.out" 2>"$work/blocked.err"
status=$?
set -e
_assert_exit "installer: refuses a non-symlink target" 1 "$status"
_assert_file_content "installer: preserves a non-symlink target" \
  "owned elsewhere" "$blocked/agent-rules-sync"
_assert_contains "installer: refusal is actionable" \
  "refusing to replace non-symlink" "$(<"$work/blocked.err")"

missing_root="$work/missing-source"
missing_prefix="$work/missing-prefix"
mkdir -p "$missing_root"
mkdir -p "$missing_root/support"
cp "$installer_delegate" "$missing_root/support/install-checkout.sh"
set +e
PREFIX="$missing_prefix" "$missing_root/support/install-checkout.sh" \
  >"$work/missing.out" 2>"$work/missing.err"
status=$?
set -e
_assert_exit "installer: rejects a missing command source" 1 "$status"
_assert_path_missing "installer: missing source publishes no command" \
  "$missing_prefix/bin/agent-rules-sync"
_assert_contains "installer: missing source is actionable" \
  "command source is not executable" "$(<"$work/missing.err")"

_test_summary
