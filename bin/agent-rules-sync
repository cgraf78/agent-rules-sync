#!/usr/bin/env bash
# Synchronize shared rule and playbook routing documents for supported agents.

set -u

if ((BASH_VERSINFO[0] < 4)); then
  printf 'agent-rules-sync: Bash 4.0 or newer is required (found %s)\n' \
    "$BASH_VERSION" >&2
  exit 1
fi

_agent_rules_script_parent() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

_agent_rules_script_dir() {
  local path="$1" dir target
  case "$path" in
    */*) ;;
    *) path=$(command -v "$path") || return 1 ;;
  esac
  while [[ -L "$path" ]]; do
    dir=$(cd -P -- "$(_agent_rules_script_parent "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    [[ "$target" == /* ]] || target="$dir/$target"
    path="$target"
  done
  cd -P -- "$(_agent_rules_script_parent "$path")" && pwd
}

_AGENT_RULES_BIN_DIR=$(_agent_rules_script_dir "${BASH_SOURCE[0]}") || {
  printf 'agent-rules-sync: cannot resolve the installation directory\n' >&2
  exit 1
}
_AGENT_RULES_LIB_DIR=$(cd "$_AGENT_RULES_BIN_DIR/../lib/agent-rules-sync" && pwd -P) || {
  printf 'agent-rules-sync: private library is not installed\n' >&2
  exit 1
}
# shellcheck source=../lib/agent-rules-sync/api.sh
. "$_AGENT_RULES_LIB_DIR/api.sh"

usage() {
  cat <<'EOF'
Usage: agent-rules-sync [--manifest FILE]
       agent-rules-sync uninstall

With no command, render and publish the selected rules. `uninstall` removes
only provider-owned generated blocks.

Manifest selection:
  --manifest FILE
  $AGENT_RULES_SYNC_MANIFEST
  $XDG_CONFIG_HOME/agent-rules-sync/manifest.tsv

Every explicit manifest path must be absolute. Relative XDG roots fall back to
their HOME defaults.
EOF
}

main() {
  local command=${1:-} manifest
  case "$command" in
    -h | --help)
      [[ "$#" -eq 1 ]] || {
        usage >&2
        return 2
      }
      usage
      ;;
    '' | --manifest)
      case "$#" in
        0)
          if [[ -n "${AGENT_RULES_SYNC_MANIFEST:-}" ]]; then
            manifest="$AGENT_RULES_SYNC_MANIFEST"
          else
            manifest=$(agent_rules_default_manifest) || return 1
          fi
          ;;
        2)
          [[ "$1" == --manifest ]] || {
            usage >&2
            return 2
          }
          manifest="$2"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      _agent_rules_require_absolute "manifest path" "$manifest" || return 1
      _agent_rules_install_temp_traps
      agent_rules_sync "$manifest"
      ;;
    uninstall)
      [[ "$#" -eq 1 ]] || {
        usage >&2
        return 2
      }
      _agent_rules_install_temp_traps
      agent_rules_uninstall
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
